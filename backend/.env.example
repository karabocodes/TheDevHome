# Chatbot Backend Configuration (options: gemini | ollama | anthropic)
LLM_PROVIDER=gemini

# Google Gemini Configuration (Free tier models: gemini-1.5-flash or gemini-2.0-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Configuration (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Optional Anthropic Provider (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
